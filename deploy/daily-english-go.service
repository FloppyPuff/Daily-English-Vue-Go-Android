[Unit]
Description=Daily English Go API
After=network.target

[Service]
Type=simple
User=daily-english
Group=daily-english
WorkingDirectory=/opt/daily-english-go
Environment=HOST=127.0.0.1
Environment=PORT=8788
Environment=DATA_DIR=/var/lib/daily-english
Environment=COOKIE_SECURE=1
Environment=TRUST_PROXY=1
Environment=ACCOUNTS_OPEN=1
ExecStart=/opt/daily-english-go/daily-english-go
Restart=always
RestartSec=3
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/daily-english
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
