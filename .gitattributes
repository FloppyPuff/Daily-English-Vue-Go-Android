# Line endings matter here: the deploy scripts and the Gradle wrapper are
# executed on Linux by CI and by systemd, where a stray CR breaks the shebang.
* text=auto eol=lf

*.sh text eol=lf
gradlew text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.jar binary
*.keystore binary
*.jks binary
*.apk binary
*.woff binary
*.woff2 binary
*.ttf binary
